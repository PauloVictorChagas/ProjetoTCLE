# Hosts permitidos, separados por vírgula (padrão: localhost,127.0.0.1,[::1])
# DJANGO_ALLOWED_HOSTS=tcle.suaunidade.gov.br
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tcle.suaunidade.gov.br

# Fora do DEBUG o sistema assume HTTPS (cookies seguros, redirecionamento e HSTS).
# Só desative de forma consciente, em rede interna sem HTTPS:
# DJANGO_HTTPS=False
# Atrás de proxy reverso confiável que define X-Forwarded-Proto:
# DJANGO_ATRAS_DE_PROXY=True

# Inatividade (minutos) até a sessão expirar (padrão: 60)
# DJANGO_SESSAO_MINUTOS=60
# Caminho do painel administrativo do Django (padrão: admin/)
# DJANGO_ADMIN_URL=admin/

